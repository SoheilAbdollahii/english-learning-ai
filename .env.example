# Copy to .env locally; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP only. In production, set true after HTTPS termination is configured.
DJANGO_SECURE_SSL_REDIRECT=false
# Keep HSTS at zero until HTTPS works for every covered hostname; configure in production after validation.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Enable only when a trusted proxy strips client-supplied forwarded headers and sets this itself.
DJANGO_TRUST_X_FORWARDED_PROTO=false
# Anonymous registration throttle; use a shared production cache.
REGISTRATION_RATE_LIMIT=5/hour
DATABASE_URL=postgresql://english_learning:local_password@localhost:5432/english_learning
# Optional shared cache URL; Docker Compose configures redis://redis:6379/1 automatically.
# Set REDIS_URL in multi-worker production deployments for consistent API throttling.
REDIS_URL=
# Local development can print account emails to backend logs. Set SMTP backend and credentials in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Wordwise <no-reply@example.com>
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_RATE_LIMIT=5/hour
EMAIL_VERIFICATION_RATE_LIMIT=5/hour
# Optional: enable real Writing feedback with the Gemini Developer API.
# Create a key at https://aistudio.google.com/ and keep it server-side.
# Without a key, Writing uses the explicitly labelled demo provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25
# Maximum provider-backed writing submissions per authenticated learner per hour.
WRITING_SUBMISSIONS_PER_HOUR=10/hour
# Durable rolling-24-hour writing quota per learner (database-backed).
WRITING_SUBMISSIONS_PER_DAY=30

# Optional token-based cost estimation. Set BOTH rates from the active vendor price sheet.
# Values are micro-units of the billing currency per 1,000,000 tokens; blank means no cost estimate.
GEMINI_INPUT_COST_MICROUNITS_PER_MILLION_TOKENS=
GEMINI_OUTPUT_COST_MICROUNITS_PER_MILLION_TOKENS=
